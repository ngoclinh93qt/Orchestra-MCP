# Deployment settings for this machine. Copy to .env and fill in your own values:
#
#   cp .env.example .env
#
# .env is git-ignored: it holds the details of your deployment (your hostname,
# your folders), not secrets. Secrets — the recovery code, the local bearer
# token, OAuth tokens, tunnel credentials — never live in a file in this
# repository; see README.md.
#
# scripts/install-services.sh reads this file when it renders the LaunchAgent
# plists and the Codex plugin's .mcp.json, so the values below end up baked
# into the installed service. Re-run that script after changing them.

# Required. The public HTTPS endpoint your Cloudflare Tunnel routes to this
# bridge. Must end in /mcp. It is also the OAuth issuer and resource
# identifier, so it has to match what clients connect to, exactly.
AGENT_BRIDGE_PUBLIC_URL=https://mcp.example.com/mcp

# Seeds the folder allowlist the first time the bridge creates its config.json.
# After that, the access policy lives in
# ~/Library/Application Support/Agent Bridge MCP/config.json and this is
# ignored. Colon-separated absolute paths.
AGENT_BRIDGE_ALLOWED_ROOTS=/Users/you/projects

# Optional. Absolute paths to the provider CLIs, if the bridge cannot find them
# on its own (it searches PATH, then the usual install locations).
#AGENT_BRIDGE_CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
#AGENT_BRIDGE_CLAUDE_BIN=/Users/you/.local/bin/claude

# Optional. Defaults shown.
#AGENT_BRIDGE_PORT=8787
#AGENT_BRIDGE_STATE_DIR=$HOME/Library/Application Support/Agent Bridge MCP
#AGENT_BRIDGE_MAX_CONCURRENT_TOTAL=2
#AGENT_BRIDGE_MAX_CONCURRENT_PER_PROVIDER=1
