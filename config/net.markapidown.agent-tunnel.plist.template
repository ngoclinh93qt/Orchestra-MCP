<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.markapidown.agent-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CLOUDFLARED_BIN__</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>__CLOUDFLARED_CONFIG__</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__STATE_DIR__/logs/agent-tunnel.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__STATE_DIR__/logs/agent-tunnel.stderr.log</string>
</dict>
</plist>
